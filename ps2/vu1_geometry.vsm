; CTR PS2 VU1 packed-geometry proof
;
; Common VU1 memory (absolute):
;   0..3   object-to-screen matrix columns
;
; Current TOP/TOPS-relative input:
;   0      scale.xyz + vertex_count.w
;   1      screen offset.xyz
;   2      primitive GIFtag
;   3      RGBA constant
;   4      STQ base constant
;   5      FINISH GIFtag
;   6      FINISH A+D payload
;   7..    positions expanded by VIF1 from signed V3-16 to [x y z 1]
;
; Output begins at TOP + 64 and is GS-ready REGLIST data. Positions arrive as
; signed 12.4 fixed-point values; VIF performs width expansion and VU1 performs
; ITOF4 locally before transform. This is a correctness-first schedule. Stalls
; are intentionally explicit until hardware validation and a measured scheduler
; pass replace them.

        .vu
        .align 4
        .global CTRPS2_VU1_GeometryStart
        .global CTRPS2_VU1_GeometryEnd

CTRPS2_VU1_GeometryStart:
        NOP                             lq          VF01, 0(VI00)
        NOP                             xtop        VI02
        NOP                             lq          VF02, 1(VI00)
        NOP                             lq          VF03, 2(VI00)
        NOP                             lq          VF04, 3(VI00)

        NOP                             lq          VF05, 0(VI02)
        NOP                             lq          VF13, 1(VI02)
        NOP                             lq          VF06, 2(VI02)
        NOP                             lq          VF08, 3(VI02)
        NOP                             lq          VF09, 4(VI02)
        NOP                             lq          VF10, 5(VI02)
        NOP                             lq          VF11, 6(VI02)

        NOP                             ilw.w       VI07, 0(VI02)
        NOP                             iaddiu      VI03, VI02, 7
        NOP                             iadd        VI04, VI03, VI07
        NOP                             iaddiu      VI05, VI02, 64
        NOP                             iaddiu      VI06, VI05, 0
        NOP                             sqi         VF06, (VI06++)

CTRPS2_VU1_GeometryLoop:
        NOP                             lq          VF07, 0(VI03)
        NOP                             iaddiu      VI03, VI03, 1
        itof4.xyz     VF07, VF07        NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP

        mulax         ACC, VF01, VF07x  NOP
        madday        ACC, VF02, VF07y  NOP
        maddaz        ACC, VF03, VF07z  NOP
        maddw         VF07, VF04, VF07w NOP

        NOP                             div         Q, VF00w, VF07w
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP

        mulq.xyz      VF07, VF07, Q     NOP
        mulq          VF12, VF09, Q     NOP
        mul.xyz       VF07, VF07, VF05  NOP
        add.xyz       VF07, VF07, VF13  NOP
        ftoi4.xyz     VF07, VF07        NOP

        NOP                             sq          VF12, 0(VI06)
        NOP                             sq          VF08, 1(VI06)
        NOP                             isw.w       VI00, 2(VI06)
        NOP                             sq.xyz      VF07, 2(VI06)
        NOP                             iaddiu      VI06, VI06, 3
        NOP                             ibne        VI03, VI04, CTRPS2_VU1_GeometryLoop
        NOP                             NOP

        NOP                             sqi         VF10, (VI06++)
        NOP                             sqi         VF11, (VI06++)
        NOP                             xgkick      VI05
        NOP[E]                          NOP
        NOP                             NOP

        .align 4
CTRPS2_VU1_GeometryEnd:
