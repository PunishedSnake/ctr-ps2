; CTR PS2 native track VU1 program
;
; N2c hoists frame/pass constants out of every cluster header. Screen scale,
; screen offset and the single pass FINISH payload live in absolute VU memory
; below VIF1 BASE. Per-cluster TOP/TOPS input now carries only data that actually
; varies between clusters.
;
; Common VU1 memory (absolute):
;   0..3   object-to-screen matrix columns
;   4      screen scale.xyz
;   5      screen offset.xyz
;   6      pass FINISH GIFtag
;   7      pass FINISH A+D payload
;
; TOP/TOPS-relative input:
;   0      vertex_count.w
;   1      primitive GIFtag (PACKED ST, RGBAQ, XYZ2)
;   2      st_scale.xy
;   3      pass control (w != 0 only for final batch)
;   4..4+N-1       positions expanded from signed V3-16
;   4+N..4+2N-1    colors expanded from unsigned V4-8
;   4+2N..4+3N-1   source texcoords expanded from V2-16 or V4-16
;
; Output begins at TOP+96:
;   GIFtag
;   [packed STQ qword, packed RGBAQ qword, packed XYZ2 qword] * N
;   optional final FINISH GIFtag + A+D payload

        .vu
        .align 4
        .global CTRPS2_VU1_NativeTrackStart
        .global CTRPS2_VU1_NativeTrackEnd

CTRPS2_VU1_NativeTrackStart:
        NOP                             lq          VF01, 0(VI00)
        NOP                             xtop        VI02
        NOP                             lq          VF02, 1(VI00)
        NOP                             lq          VF03, 2(VI00)
        NOP                             lq          VF04, 3(VI00)
        NOP                             lq          VF05, 4(VI00)
        NOP                             lq          VF13, 5(VI00)
        NOP                             lq          VF10, 6(VI00)
        NOP                             lq          VF11, 7(VI00)

        NOP                             lq          VF06, 1(VI02)
        NOP                             lq          VF12, 2(VI02)
        NOP                             ilw.w       VI10, 3(VI02)
        NOP                             ilw.w       VI07, 0(VI02)
        NOP                             iaddiu      VI03, VI02, 4
        NOP                             iadd        VI04, VI03, VI07
        NOP                             iadd        VI08, VI04, VI00
        NOP                             iadd        VI09, VI08, VI07
        NOP                             iaddiu      VI05, VI02, 96
        NOP                             iaddiu      VI06, VI05, 0
        NOP                             sqi         VF06, (VI06++)

CTRPS2_VU1_NativeTrackLoop:
        NOP                             lq          VF07, 0(VI03)
        NOP                             lq          VF14, 0(VI08)
        NOP                             lq          VF15, 0(VI09)
        NOP                             iaddiu      VI03, VI03, 1
        NOP                             iaddiu      VI08, VI08, 1
        NOP                             iaddiu      VI09, VI09, 1

        itof4.xyz     VF07, VF07        NOP
        itof4.xy      VF15, VF15        NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        mul.xy        VF15, VF15, VF12  NOP
        ; V2 UNPACK leaves Z/W unspecified. Explicitly create Q lane state.
        addw.z        VF15, VF00, VF00w NOP

        mulax         ACC, VF01, VF07x  NOP
        madday        ACC, VF02, VF07y  NOP
        maddaz        ACC, VF03, VF07z  NOP
        maddw         VF07, VF04, VF07w NOP

        NOP                             div         Q, VF00w, VF07w
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP
        NOP                             NOP

        mulq.xyz      VF15, VF15, Q     NOP
        mulq.xyz      VF07, VF07, Q     NOP
        mul.xyz       VF07, VF07, VF05  NOP
        add.xyz       VF07, VF07, VF13  NOP
        ftoi4.xyz     VF07, VF07        NOP

        NOP                             sq          VF15, 0(VI06)
        NOP                             sq          VF14, 1(VI06)
        NOP                             isw.w       VI00, 2(VI06)
        NOP                             sq.xyz      VF07, 2(VI06)
        NOP                             iaddiu      VI06, VI06, 3
        NOP                             ibne        VI03, VI04, CTRPS2_VU1_NativeTrackLoop
        NOP                             NOP

        NOP                             ibne        VI10, VI00, CTRPS2_VU1_NativeTrackEmitFinish
        NOP                             NOP

CTRPS2_VU1_NativeTrackKick:
        NOP                             xgkick      VI05
        NOP[E]                          NOP
        NOP                             NOP

CTRPS2_VU1_NativeTrackEmitFinish:
        NOP                             sqi         VF10, (VI06++)
        NOP                             sqi         VF11, (VI06++)
        NOP                             xgkick      VI05
        NOP[E]                          NOP
        NOP                             NOP

        .align 4
CTRPS2_VU1_NativeTrackEnd:
